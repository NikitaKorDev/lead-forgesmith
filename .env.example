# Copy to .env. Every setting is prefixed FORGESMITH_.

# --- Database -----------------------------------------------------------------
# Production is SQLite on the named Docker volume (compose sets
# FORGESMITH_DATA_DIR=/app/data and a database URL under it). For local dev the
# default is data/forgesmith.db; no server is required.
# Postgres remains supported in code for branch hygiene, not as a Phase 5
# deliverable:
# FORGESMITH_DATABASE_URL=postgresql+asyncpg://forgesmith:forgesmith@localhost:5432/forgesmith
# FORGESMITH_DATA_DIR=data
# FORGESMITH_DATABASE_URL=sqlite+aiosqlite:///data/forgesmith.db

# --- Crawling -----------------------------------------------------------------
# FORGESMITH_REQUEST_DELAY=1.5
# FORGESMITH_MAX_CONCURRENCY=5
# FORGESMITH_REQUEST_TIMEOUT=20
# FORGESMITH_MAX_RETRIES=2

# --- Shopify source -----------------------------------------------------------
# FORGESMITH_SHOPIFY_SEEDS_FILE=data/shopify_seeds.txt
# FORGESMITH_SHOPIFY_PRODUCTS_LIMIT=250

# --- OLX source ---------------------------------------------------------------
# FORGESMITH_OLX_MAX_PAGES=3

# --- Enrichment (phase 2) -----------------------------------------------------
# HTTP first; Chromium only after a block/challenge on that host.
# FORGESMITH_ENRICH_MAX_PAGES=5
# FORGESMITH_ENRICH_MAX_ATTEMPTS=3
# FORGESMITH_ENRICH_LEAD_TIMEOUT=60
# FORGESMITH_ENRICH_PAGE_TIMEOUT=10
# FORGESMITH_ENRICH_MAX_BYTES=2000000
# FORGESMITH_ENRICH_TEXT_CHARS=3000
# FORGESMITH_ENRICH_EMAIL_LIMIT=3
# FORGESMITH_ENRICH_BROWSER_SETTLE_MS=3000
# FORGESMITH_ENRICH_RESPECT_ROBOTS=true
# FORGESMITH_ENRICH_DOMAIN_OVERRIDES=data/domain_overrides.csv

# --- LLM / compose (phase 3) --------------------------------------------------
# Local Ollama is the default so scraped site text stays on this machine.
# FORGESMITH_OLLAMA_BASE_URL=http://localhost:11434
# FORGESMITH_OLLAMA_MODEL=qwen2.5:7b
# FORGESMITH_OLLAMA_TIMEOUT=120
# FORGESMITH_COMPOSE_TEMPERATURE=0.4
# FORGESMITH_COMPOSE_NUM_PREDICT=600
# FORGESMITH_COMPOSE_MAX_ATTEMPTS=3
# FORGESMITH_COMPOSE_BODY_MIN_WORDS=80
# FORGESMITH_COMPOSE_BODY_MAX_WORDS=140
# FORGESMITH_COMPOSE_MIN_CONTEXT_CHARS=120

# Compose fails fast until all four required sender fields are set. These are
# also the Phase 4 SMTP identity, so the footer cannot disagree with From.
# FORGESMITH_MAIL_FROM_NAME=
# FORGESMITH_MAIL_FROM_ADDRESS=
# FORGESMITH_SENDER_COMPANY=
# FORGESMITH_SENDER_OFFER=
# FORGESMITH_SENDER_PORTFOLIO_URL=

# --- Mailer (phase 4) ---------------------------------------------------------
# The CLI is dry-run unless --live. `mail_dry_run` is also the unattended kill
# switch: live=true while it is true sends nothing and exits 0. Keep it true in
# .env; set it false only in .env.live for the scheduled live service.
# FORGESMITH_MAIL_DRY_RUN=true
# FORGESMITH_SMTP_HOST=smtp.gmail.com
# FORGESMITH_SMTP_PORT=587
# FORGESMITH_SMTP_USER=
# FORGESMITH_SMTP_PASSWORD=
# FORGESMITH_SMTP_SSL=false              # 465 implicit TLS
# FORGESMITH_SMTP_STARTTLS=true          # 587 STARTTLS
# FORGESMITH_SMTP_TIMEOUT=30
# FORGESMITH_MAIL_DAILY_CAP=20
# FORGESMITH_MAIL_DELAY_MEAN=540
# FORGESMITH_MAIL_DELAY_SIGMA=180
# FORGESMITH_MAIL_DELAY_MIN=120
# FORGESMITH_MAIL_DELAY_MAX=1800
# FORGESMITH_MAIL_BACKOFF_BASE=300
# FORGESMITH_MAIL_BACKOFF_CAP=3600
# FORGESMITH_MAIL_WINDOW_START=9
# FORGESMITH_MAIL_WINDOW_END=17
# FORGESMITH_MAIL_WINDOW_TZ=Europe/Warsaw
# FORGESMITH_MAIL_WEEKDAYS_ONLY=true
# FORGESMITH_MAIL_MAX_ATTEMPTS=3
# Comma-separated emails/domains; empty allows every approved recipient.
# FORGESMITH_MAIL_ALLOWLIST=

# --- Inbox ingest (phase 4.5) -------------------------------------------------
# Read-only IMAP: EXAMINE + BODY.PEEK only, so messages stay unread for the
# human who still reads the mailbox. TLS is mandatory: set either SSL (465) or
# STARTTLS (143); plaintext credentials are refused.
# FORGESMITH_IMAP_HOST=imap.gmail.com
# FORGESMITH_IMAP_PORT=993
# FORGESMITH_IMAP_USER=
# FORGESMITH_IMAP_PASSWORD=
# FORGESMITH_IMAP_SSL=true
# FORGESMITH_IMAP_STARTTLS=false
# FORGESMITH_IMAP_TIMEOUT=30
# FORGESMITH_IMAP_MAILBOX=INBOX
# First run without a cursor only scans this many days back.
# FORGESMITH_IMAP_LOOKBACK_DAYS=30
# FORGESMITH_IMAP_FETCH_LIMIT=200
# Skip BODY.PEEK[TEXT] above this size (headers only); reports and threads only.
# FORGESMITH_IMAP_MAX_BODY_BYTES=262144
# The lock lives at DATA_DIR/inbox.lock (separate from mailer.lock).

# --- Phase 5: containers / scheduled operation --------------------------------
# Containers set DATA_DIR and DATABASE_URL in docker-compose.yml. Keep these
# commented on the host dev path.
# FORGESMITH_LOG_JSON=true
# FORGESMITH_BROWSER_NO_SANDBOX=false
# "unattended" makes `forgesmith approve` refuse; leave empty for human review.
# FORGESMITH_APPROVAL_CHANNEL=
# Wall-clock budget for one live send tick; 0 disables the budget.
# FORGESMITH_SEND_MAX_RUNTIME=720
# SQLite writer wait when two stages contend; WAL is always enabled.
# FORGESMITH_DB_BUSY_TIMEOUT_MS=5000
# `doctor` warns when a stage has not run for this many seconds.
# FORGESMITH_STAGE_STALE_AFTER=21600

