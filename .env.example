# Copy to .env. Every setting is prefixed FORGESMITH_.

# --- Database -----------------------------------------------------------------
# Dev default is SQLite so the pipeline runs with zero infrastructure.
# Switch to Postgres (docker-compose) with:
# FORGESMITH_DATABASE_URL=postgresql+asyncpg://forgesmith:forgesmith@localhost:5432/forgesmith
# FORGESMITH_DATABASE_URL=sqlite+aiosqlite:///data/forgesmith.db

# --- Crawling -----------------------------------------------------------------
# FORGESMITH_REQUEST_DELAY=1.5
# FORGESMITH_MAX_CONCURRENCY=5
# FORGESMITH_REQUEST_TIMEOUT=20
# FORGESMITH_MAX_RETRIES=2

# --- Shopify source -----------------------------------------------------------
# FORGESMITH_SHOPIFY_SEEDS_FILE=data/shopify_seeds.txt
# FORGESMITH_SHOPIFY_PRODUCTS_LIMIT=250

# --- OLX source ---------------------------------------------------------------
# FORGESMITH_OLX_MAX_PAGES=3

# --- Enrichment (phase 2) -----------------------------------------------------
# HTTP first; Chromium only after a block/challenge on that host.
# FORGESMITH_ENRICH_MAX_PAGES=5
# FORGESMITH_ENRICH_MAX_ATTEMPTS=3
# FORGESMITH_ENRICH_LEAD_TIMEOUT=60
# FORGESMITH_ENRICH_PAGE_TIMEOUT=10
# FORGESMITH_ENRICH_MAX_BYTES=2000000
# FORGESMITH_ENRICH_TEXT_CHARS=3000
# FORGESMITH_ENRICH_EMAIL_LIMIT=3
# FORGESMITH_ENRICH_BROWSER_SETTLE_MS=3000
# FORGESMITH_ENRICH_RESPECT_ROBOTS=true
# FORGESMITH_ENRICH_DOMAIN_OVERRIDES=data/domain_overrides.csv

# --- LLM (phase 3) ------------------------------------------------------------
# FORGESMITH_OLLAMA_BASE_URL=http://localhost:11434
# FORGESMITH_OLLAMA_MODEL=qwen2.5:7b

# --- Mailer (phase 4) ---------------------------------------------------------
# Dry-run is the default: messages are written to data/outbox as .eml files.
# FORGESMITH_MAIL_DRY_RUN=true
# FORGESMITH_SMTP_HOST=smtp.gmail.com
# FORGESMITH_SMTP_PORT=587
# FORGESMITH_SMTP_USER=
# FORGESMITH_SMTP_PASSWORD=
# FORGESMITH_MAIL_FROM_NAME=
# FORGESMITH_MAIL_FROM_ADDRESS=
# FORGESMITH_MAIL_DAILY_CAP=20
